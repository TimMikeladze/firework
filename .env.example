# Umami analytics — entirely optional. Without NEXT_PUBLIC_UMAMI_WEBSITE_ID the
# tracker is never loaded and the app runs exactly as it does today.
# These are inlined at build time, so changing them needs a redeploy.

# The website's UUID from the Umami dashboard. The only required value.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Tracker script, or just the instance origin.
# Defaults to https://linesofcode-umami.vercel.app/script.js
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=

# Comma-separated hostnames allowed to report. Set this to keep Vercel preview
# deployments out of the numbers. Each entry is paired with its www. counterpart,
# so one spelling covers a site that answers on both.
# NEXT_PUBLIC_UMAMI_DOMAINS=firework.sh
